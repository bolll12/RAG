RAG_DB=data/rag.db
# 未配置时为本地演示；对外提供服务前设置访问密钥。
RAG_API_KEY=
# 以下 URL 均包含 /v1。可使用本地 Ollama 或其他兼容服务。
RAG_CHAT_BASE_URL=http://localhost:11434/v1
RAG_CHAT_MODEL=
RAG_CHAT_API_KEY=
RAG_EMBED_BASE_URL=http://localhost:11434/v1
RAG_EMBED_MODEL=
RAG_EMBED_API_KEY=
RAG_TIMEOUT=45
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_CONTEXT_CHARS=6000
# 向量候选阈值需通过实际评测校准，不是置信度。
RAG_MIN_COSINE=0.35
# 关键词候选：最低查询词覆盖率、相对最佳候选的最低分数比例。
# 均为 0..1；增大可减少噪声，也可能漏召回。调整无需重建索引。
RAG_MIN_LEXICAL_COVERAGE=0.5
RAG_MIN_LEXICAL_RATIO=0.5

# Jev 证据过滤与重排；密钥留空禁用。密钥仅保存在服务端。
RAG_JEV_URL=https://tokendance.space/gateway/typesafe/v1/systemone
RAG_JEV_MODEL=bocha-jev-v1
RAG_JEV_API_KEY=
# 初始阈值，须使用实际数据评测校准；不是正确率保证。
RAG_JEV_THRESHOLD=0.9
RAG_JEV_CANDIDATES=10
RAG_JEV_TIMEOUT=30

# LLM Wiki：兼容 chat/completions 且支持 JSON 输出的生成模型。
# 此处以阿里云百炼北京地域为例；其他地域需使用对应地址和密钥。
# 模型名留空时停用 Wiki 生成。密钥仅保存在实际 .env 中。
RAG_WIKI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_WIKI_MODEL=
RAG_WIKI_API_KEY=
RAG_WIKI_BATCH_CHARS=2500
RAG_WIKI_TIMEOUT=180
RAG_WIKI_AUTO_UPDATE=true
