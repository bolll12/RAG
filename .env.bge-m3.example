# 先启动 scripts/ollama.sh serve，并拉取 bge-m3。
# 切换模型必须使用已重建的索引，不要指向旧 BM25 数据库。
RAG_DB=data/rag-bge-m3.db
RAG_EMBED_BASE_URL=http://127.0.0.1:11434/v1
RAG_EMBED_MODEL=bge-m3
RAG_TIMEOUT=180
RAG_MIN_COSINE=0.53
RAG_MIN_LEXICAL_COVERAGE=0.5
RAG_MIN_LEXICAL_RATIO=0.5
# bge-m3 仅用于 Embedding；回答仍为原文摘录。
RAG_CHAT_MODEL=
